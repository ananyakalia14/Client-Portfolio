21:["$","$L2f",null,{"items":[{"src":"/work/PH-launch-intro.webp","alt":"Plane's Product Hunt listing — “AI-native project management,” upvoted 250, tagged productivity, task management and open source, with the team's faces below, every face but mine blurred","ar":2.6867088607594938,"span":true},{"w":5760,"h":3240,"src":"/work/PH-cards-unify.webp","alt":"a kanban board of work items across backlog, todo, in progress and done, behind the headline “Plane unifies Projects, Documentation, and AI — so you're not piecing together your work from ten different tools”","ar":1.7777777777777777,"spot":true},{"w":1920,"h":1080,"src":"/work/PH-cards-one.webp","alt":"a project-management dashboard behind the headline “sure, you've broken goals before. just never this cleanly” — progress bars and an updates feed","ar":1.7777777777777777,"spot":true},{"w":1920,"h":1080,"src":"/work/PH-cards-two.webp","alt":"a workspace's workflow settings, transitions and reviewers configured, behind the headline “workflows and automations to do the chasing, updating, and nudging. so you don't have to”","ar":1.7777777777777777,"spot":true},{"w":1920,"h":1080,"src":"/work/PH-cards-three.webp","alt":"a wiki page, “company and culture,” open in a docs editor behind the headline “docs and work, now officially inseparable”","ar":1.7777777777777777,"spot":true},{"w":5760,"h":3240,"src":"/work/PH-cards-six.webp","alt":"an AI chat creating and approving work items beside the headline “get more AI with Plane AI than anywhere else”","ar":1.7777777777777777,"spot":true},{"w":5760,"h":3240,"src":"/work/PH-cards-five.webp","alt":"the Plane logo on navy over “open-source at its core,” with cloud, self-hosted and airgapped icons","ar":1.7777777777777777,"spot":true},{"src":"/work/PH-maker-comment.webp","alt":"the maker comment on Plane's launch, the founder's name blurred — why Plane was built, open core, who uses it, and a 30% launch offer","ar":1.113905325443787,"span":true,"mat":true,"title":"maker comment"}]}]
