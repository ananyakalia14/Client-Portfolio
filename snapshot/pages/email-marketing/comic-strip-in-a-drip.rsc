ickly",["$","span",null,{"className":"fullstop","children":"."}]]}],["$","$1",".0/.$11",{"children":[" so that's the drip",["$","span",null,{"className":"fullstop","children":"."}]]}],["$","$1",".0/.$12",{"children":[" sixty-something e-mails, and i'd send every one of them again",["$","span",null,{"className":"fullstop","children":"."}]]}],["$","$1",".0/.$13",{"children":[" thanks for reading this far",["$","span",null,{"className":"fullstop","children":"."}]]}],["$","$1",".0/.$14",{"children":[" you'd have opened e-mail thirteen ",false]}],["$","span",".1",{"className":"bo-nowrap","children":[["$","$1","0",{"children":["too",["$","span",null,{"className":"fullstop","children":"."}]]}],["$","$1","1",{"children":[" 😉",false]}]]}]]}]}]]}]
